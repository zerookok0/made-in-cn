# WordPress / WooCommerce store that receives the cart at checkout.
# Leave unset to show the "checkout not connected" notice.
VITE_WP_SITE_URL=https://your-wordpress-site.example

# Optional: set a subdirectory base, e.g. /site/
# VITE_BASE=/site/

# Optional: use clean URLs instead of hash routing.
# VITE_ROUTER=history
